EarthLike -> TexturesEL $OBJ
AtmosphereEL [ ] Atmosphere $OBJ margin=0.1
EarthLike -> AtmosphereEL $OBJ
TexturesMoon [ ] Textures $OBJ margin=0.1
Moons -> TexturesMoon $OBJ
Rocky -> TexturesMoon $OBJ


