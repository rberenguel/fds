# Stardust

// https://mostlymaths.net/garbuix/?view=https://raw.githubusercontent.com/rberenguel/fds/refs/heads/gh-pages/wip/notes/stardust.cmap

$DARK

$MAIN=fontsize=50 color="$RED" penwidth="5" fillcolor="#cc660033" fontname="inter-italic"

$INDIRECT=style="dashed" color="$YELLOW" penwidth="3"
$CLOSE=len=0.5 color="$RED" penwidth="3" style=""

$GREY=#cccccc
$NOTE=shape=plaintext fontcolor="$YELLOW"
$SUBTLE=; color="$GREY" style="dotted" arrowhead=none

$OBJ=; color="$GREY" fillcolor="#cccccc33" fontcolor="$GREY" fontname="inter" fontsize=30 len=0.5 arrowhead=none

layout="dot"
sep=0.3
maxiter=10
start=1

fontsize=80
fontname="inter-bolditalic"
fontcolor="$ORANGE"

// System


stardust_note Ideas, links, and missing elements for the implementation of Stardust. This is where I braindump some stuff ; $NOTE


System System ; $MAIN


stardust_note -> System !


Sun Sun $OBJ
Planets Planets $OBJ
EarthLike Earth-like $OBJ
Rocky Rocky $OBJ
GasGiant Gas giant $OBJ
IceGiant Ice giant $OBJ
Moons Moons $OBJ
StarDensity Background\nstar density $OBJ
DustDensity Background\ndust density $OBJ
Nebula Nebula in\nbackground $OBJ


